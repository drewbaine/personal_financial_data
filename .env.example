# Copy to .env and fill in. Never commit .env.

# From https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox

# SQLite for now; later e.g. postgresql+psycopg://finance:pass@db:5432/finance
DATABASE_URL=sqlite:///data/finance.db

# Encrypts Plaid access tokens at rest. Generate with: uv run finance gen-key
# Losing this key means re-linking every account.
FINANCE_ENCRYPTION_KEY=
